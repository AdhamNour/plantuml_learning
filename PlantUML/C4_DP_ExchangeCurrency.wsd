@startuml
'https://plantuml.com/component-diagram
@startuml
!include C4_Generic_Template.puml

AddRelTag("dotted", $textColor="$ARROW_COLOR", $lineColor="$ARROW_COLOR", $lineStyle = DottedLine(), $legendText="a dotted relation")

' Person(user, "user")


System_Boundary(bank, "Croatia"){
    
    System_Boundary(DPSystem, "Data platform") {
    
  System_Boundary(DWHDatabase,"DWH Database") {
    System(DWHDB, "DWH Database", $sprite="database", $tags="impacted_component")
  }
  }

	System_Boundary(T24System, "CB platform") {
  System_Boundary(SystemT24,"T24 Database") {
    System(T24DB, "T24 Database", $sprite="database", $tags="impacted_component")
  }
  }
  }


  System_Boundary(TP, "Third Party") {
  System(ARB, "ARB", $sprite="server", $tags="no_change")
}

Rel_R(ARB,DWHDB,"Pull Data")
Rel(DWHDB,T24DB,"ETL Push")


@enduml