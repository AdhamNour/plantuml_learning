@startuml CRM_Architecture

hide stereotype

skinparam rectangle {
  BackgroundColor<<crm_core>> #1565C0
  FontColor<<crm_core>> white
  BackgroundColor<<crm_api>> #90CAF9
  FontColor<<crm_api>> #0D47A1
  BackgroundColor<<etl>> #1565C0
  FontColor<<etl>> white
  BackgroundColor<<external>> #BDBDBD
  FontColor<<external>> #212121
}
skinparam database {
  BackgroundColor<<crm_core>> #1565C0
  FontColor<<crm_core>> white
  BackgroundColor<<sftp>> #D9B44A
  FontColor<<sftp>> #212121
  BackgroundColor<<objectstore>> #C74634
  FontColor<<objectstore>> white
}
skinparam file {
  BackgroundColor #D6D6E0
  FontColor #212121
}

skinparam defaultFontName Arial
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #333333
skinparam nodesep 140
skinparam ranksep 130

rectangle "CRM System" as crmBoundary #line.dashed {
  database "CRM Database" as CRM <<crm_core>>
  ' rectangle "CRM API" as API <<crm_api>>
}

rectangle "Data Team" as dataBoundary #line.dashed {
  rectangle "Data Platform ETL" as ETL <<etl>>
  file "CAFI\n(.csv)" as CAFI
  database "Data Platform Server" as OOS <<objectstore>>
}

database "Croatia SFTP\nServer Directory" as SFTP <<sftp>>
file "CAFO\n(.csv)" as CAFO

rectangle "CRM Adapter" as Adapter <<external>>
rectangle "Payment Service" as Payment <<external>>

' CRM <-> ETL flows
CRM -up-> ETL : Fetch Claims
ETL -down-> CRM : Update Claim Status

' CRM <-> API
' CRM -down-> API
' API -up-> CRM

' File generation and SFTP
ETL -right-> CAFI : Generate
CAFI -up-> SFTP : Save To\n/Upload/CAFI/

' SFTP back to ETL
SFTP -down-> ETL : Read File\n/Upload/CAFO/

' CAFO on SFTP
CAFO -down-> SFTP

' Archive copies retained by the ETL
ETL -left-> OOS : Archive Copy Of\nCAFI & CAFO

' External flows
' Adapter -up-> API : Update Fund\nTransfer Status
' Payment -up-> API : Fund Transfer

@enduml
