@startuml CRM_Architecture
title CRM Architecture

skinparam rectangle {
  BackgroundColor<<crm_core>> #1565C0
  FontColor<<crm_core>> white
  BackgroundColor<<crm_api>> #90CAF9
  FontColor<<crm_api>> #0D47A1
  BackgroundColor<<sftp>> #F9A825
  FontColor<<sftp>> white
  BackgroundColor<<external>> #BDBDBD
  FontColor<<external>> #212121
}

skinparam defaultFontName Arial
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 55

rectangle "CRM System" as boundary #line.dashed {
  rectangle "CRM" as CRM <<crm_core>>
  rectangle "CRM Internal ETL" as ETL <<crm_core>>
  rectangle "CRM API" as API <<crm_api>>
}

file "CAFO\n(.csv)" as CAFO
rectangle "Croatia SFTP\nServer Directory" as SFTP <<sftp>>
file "CAFI\n(.csv)" as CAFI

rectangle "CRM Adapter" as Adapter <<external>>
rectangle "Payment Service" as Payment <<external>>

' Internal ETL flows
CRM --> ETL : Fetch Claims
ETL --> CRM : Update Claim Status

' CRM <-> API
CRM <--> API

' File generation and SFTP
ETL --> CAFI : Generate
CAFI --> SFTP : Save To\n/Upload/CAFI/

' SFTP back to ETL
SFTP -left-> ETL : Read File\n/Upload/CAFO/

' CAFO on SFTP
CAFO --> SFTP

' External flows
Adapter --> CRM : Update Fund\nTransfer Status
Adapter -right-> Payment
Payment --> API : Fund Transfer

@enduml